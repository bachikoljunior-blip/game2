{
  "name": "@bachikoljunior/kit",
  "version": "0.1.0",
  "description": "Verified, reusable development kit extracted from eight shipped browser-game projects: measurement harness, release verification, adversarial review, and project-state gates.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./browser/*": "./lib/browser/*.mjs",
    "./image/*": "./lib/image/*.mjs",
    "./release/*": "./lib/release/*.mjs",
    "./state/*": "./lib/state/*.mjs",
    "./plan/*": "./lib/plan/*.mjs"
  },
  "scripts": {
    "test": "node --test test/run.mjs",
    "check": "npm test"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
