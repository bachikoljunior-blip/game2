{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kagerou.local/schemas/handoff.schema.json",
  "title": "KAGEROU specialist handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "producer",
    "consumer",
    "objective",
    "allowedScope",
    "inputs",
    "outputs",
    "dependencies",
    "invariants",
    "assumptions",
    "unresolvedQuestions",
    "acceptanceCriteria",
    "testsRequired",
    "risks",
    "rollback",
    "status"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "allowedScope": {"type": "array", "items": {"type": "string"}},
    "prohibitedChanges": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "affectedInterfaces": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolvedQuestions": {"type": "array", "items": {"type": "string"}},
    "acceptanceCriteria": {"type": "array", "items": {"type": "string"}},
    "testsRequired": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "accepted", "ready", "active", "blocked", "awaiting_verification", "under_review", "verified", "rejected", "deferred", "superseded", "archived"]}
  }
}
