{
  "name": "kagerou",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KAGEROU - a mobile-first AAA samurai action game built with Three.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:pages": "npm run build && node tools/sync-pages.mjs",
    "verify:pages": "node tools/verify-pages.mjs",
    "validate:project": "node tools/validate-project-state.mjs",
    "check:ownership": "node kit/tools/check-ownership.mjs --repo=.",
    "test:kit": "node --test kit/test/run.mjs",
    "check": "npm run validate:project && npm run check:ownership && npm run test:kit && npm run build",
    "gate:capture": "node tools/gate-capture-report.mjs",
    "verify:r9": "node tools/verify-r9.mjs",
    "verify:lantern-spill": "node tools/verify-lantern-spill.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "capture": "node tools/capture.mjs",
    "shots": "vite build && node tools/capture.mjs",
    "review": "vite build && node tools/capture.mjs --review --diff --profile=phone",
    "dispatch": "node tools/dispatch.mjs",
    "stale": "node tools/manifest.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "terser": "^5.44.0",
    "vite": "^6.3.6"
  }
}
